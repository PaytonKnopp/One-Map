# Normalize everything to LF in the repo; let Git handle checkout conversion.
* text=auto eol=lf

# Explicit text types (kept as LF, diffable)
*.json text eol=lf
*.geojson text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf

# Binary assets — never diffed as text, never line-ending converted
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pbf binary
*.zip binary
