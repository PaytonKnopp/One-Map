{
  "name": "one-world",
  "private": true,
  "version": "0.1.0",
  "description": "A lifelong, ever-expanding world-building map. World name is a placeholder; see data/world.json.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:data": "node scripts/format-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate.ts",
    "icons": "node scripts/icons.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "js-yaml": "5.4.2",
    "maplibre-gl": "6.11.2",
    "minisearch": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/geojson": "7946.0.16",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/unist": "3.0.3",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "svgstore": "3.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
